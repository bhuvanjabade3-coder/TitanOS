[Unit]
Description=TITAN Core (AI desktop service)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
# Secrets (ANTHROPIC_API_KEY) live in this 0600 file, never in the unit or repo.
EnvironmentFile=-%h/.config/titan/env
Environment=TITAN_STATIC_DIR=@REPO@/frontend/dist
ExecStart=@REPO@/backend/.venv/bin/titan-core
Restart=on-failure
RestartSec=3
# User service: runs as you, never as root.
NoNewPrivileges=yes

[Install]
WantedBy=graphical-session.target
